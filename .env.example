# Copy to .env. Nothing here is a secret; no API keys are needed.

# --- Ollama (local LLM) ---
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window sent to the model. Higher = more VRAM. 4096 suits a 6 GB GPU.
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2
# Turn off Qwen3's "thinking" output (faster, cleaner). Set to false to leave it on.
OLLAMA_DISABLE_THINKING=true

# --- Whisper ---
# tiny | base | small | medium | large
WHISPER_MODEL=small
# Leave empty to use the GPU when available. Set to cpu to keep GPU memory free for the LLM.
WHISPER_DEVICE=

# --- Processing ---
# Characters per piece when a long transcript is split for the LLM
CHUNK_CHARS=5000

# --- API server ---
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=500
# How many finished analyses are kept in memory
MAX_ANALYSES=20
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
